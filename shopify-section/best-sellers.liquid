{% comment %}
  Best Sellers – Shopify Section
  Uses section schema for customizable product collection selection.
{% endcomment %}

{{ 'best-sellers.css' | asset_url | stylesheet_tag }}

<section class="best-sellers" data-section-id="{{ section.id }}">
  <div class="best-sellers__container">

    <!-- Section Header -->
    <header class="best-sellers__header">
      <h2 class="best-sellers__title">{{ section.settings.heading }}</h2>
      {% if section.settings.show_view_all and section.settings.collection != blank %}
        <a href="{{ section.settings.collection.url }}" class="best-sellers__view-all">
          {{ section.settings.view_all_text }}
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      {% endif %}
    </header>

    <!-- Desktop: Horizontal Scroll Carousel -->
    <div class="best-sellers__carousel product-scroll" role="list" aria-label="Best selling products">
      {% assign collection = section.settings.collection %}
      {% assign product_limit = section.settings.products_to_show %}

      {% if collection != blank %}
        {% for product in collection.products limit: product_limit %}
          <article class="best-sellers__card" role="listitem">
            <a href="{{ product.url }}" class="best-sellers__card-link" aria-label="{{ product.title }} - {{ product.price | money }}">
              <div class="best-sellers__image-wrapper">
                {% if product.images.size > 1 %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="best-sellers__image best-sellers__image--primary"
                    loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}"
                    width="600"
                    height="600"
                  />
                  <img
                    src="{{ product.images[1] | image_url: width: 600 }}"
                    alt="{{ product.images[1].alt | escape }}"
                    class="best-sellers__image best-sellers__image--secondary"
                    loading="lazy"
                    width="600"
                    height="600"
                  />
                {% else %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="best-sellers__image best-sellers__image--primary"
                    loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}"
                    width="600"
                    height="600"
                  />
                {% endif %}

                <div class="best-sellers__badges">
                  {% for tag in product.tags %}
                    {% if tag == 'best-seller' %}
                      <span class="best-sellers__badge best-sellers__badge--seller">Best Seller</span>
                    {% endif %}
                    {% if tag == 'save-15' %}
                      <span class="best-sellers__badge best-sellers__badge--sale">Save 15%</span>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>

              <h3 class="best-sellers__product-name">{{ product.title }}</h3>

              <div class="best-sellers__rating">
                {% assign rating_value = product.metafields.reviews.rating.value | default: 4.5 %}
                <div class="best-sellers__stars" aria-label="{{ rating_value }} out of 5 stars">
                  {% for i in (1..5) %}
                    {% if i <= rating_value %}
                      <svg class="best-sellers__star best-sellers__star--filled" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    {% else %}
                      <svg class="best-sellers__star best-sellers__star--empty" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    {% endif %}
                  {% endfor %}
                </div>
                <span class="best-sellers__review-count">
                  {{ product.metafields.reviews.rating_count | default: 0 }} Reviews
                </span>
              </div>

              <p class="best-sellers__price">{{ product.price | money }}</p>
            </a>
          </article>
        {% endfor %}
      {% else %}
        <!-- Placeholder cards when no collection is selected -->
        {% for i in (1..10) %}
          <article class="best-sellers__card" role="listitem">
            <div class="best-sellers__card-link">
              <div class="best-sellers__image-wrapper best-sellers__image-wrapper--placeholder">
                {{ 'product-' | append: i | placeholder_svg_tag: 'best-sellers__placeholder-svg' }}
              </div>
              <h3 class="best-sellers__product-name">Sample Product {{ i }}</h3>
              <div class="best-sellers__rating">
                <div class="best-sellers__stars">
                  {% for star in (1..5) %}
                    <svg class="best-sellers__star best-sellers__star--filled" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  {% endfor %}
                </div>
                <span class="best-sellers__review-count">0 Reviews</span>
              </div>
              <p class="best-sellers__price">$0.00</p>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Mobile: Show More Button -->
    <div class="best-sellers__show-more-wrapper">
      <button
        class="best-sellers__show-more-btn"
        data-show-more="{{ section.id }}"
        aria-expanded="false"
      >
        Show More
      </button>
    </div>

  </div>
</section>

<script>
  (function () {
    const section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    const btn = section.querySelector('[data-show-more="{{ section.id }}"]');
    const carousel = section.querySelector('.best-sellers__carousel');

    if (btn && carousel) {
      const mobileLimit = {{ section.settings.mobile_products_to_show | default: 4 }};
      const cards = carousel.querySelectorAll('.best-sellers__card');

      function applyMobileVisibility() {
        if (window.innerWidth < 768) {
          cards.forEach(function (card, index) {
            if (index >= mobileLimit) {
              card.classList.add('best-sellers__card--hidden');
            }
          });
        } else {
          cards.forEach(function (card) {
            card.classList.remove('best-sellers__card--hidden');
          });
        }
      }

      applyMobileVisibility();
      window.addEventListener('resize', applyMobileVisibility);

      btn.addEventListener('click', function () {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        cards.forEach(function (card, index) {
          if (index >= mobileLimit) {
            if (isExpanded) {
              card.classList.add('best-sellers__card--hidden');
            } else {
              card.classList.remove('best-sellers__card--hidden');
            }
          }
        });

        btn.setAttribute('aria-expanded', !isExpanded);
        btn.textContent = isExpanded ? 'Show More' : 'Show Less';
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Best Sellers",
  "tag": "section",
  "class": "best-sellers-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_products_to_show",
      "label": "Products visible on mobile",
      "min": 2,
      "max": 10,
      "step": 2,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "'View All' link text",
      "default": "Shop All Best Sellers"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers",
      "category": "Collection"
    }
  ]
}
{% endschema %}
